{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "research_goal",
    "data_frequency",
    "prediction_horizon",
    "research_direction",
    "constraints",
    "evaluation"
  ],
  "properties": {
    "research_goal": {
      "type": "string",
      "minLength": 1
    },
    "data_frequency": {
      "type": "string",
      "minLength": 1
    },
    "prediction_horizon": {
      "type": [
        "string",
        "integer",
        "number"
      ],
      "minLength": 1
    },
    "research_direction": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

